{
  "name": "shlink-dashboard",
  "description": "",
  "main": "build/server.js",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build && tsc --project tsconfig.build-server.json && cp -R app/db/migrations build/migrations && cp migrations.config.ts build/migrations.config.ts && tsx scripts/replace-version.ts",
    "build:dist": "node --run build && tsx ./scripts/create-dist-file.ts",
    "test": "vitest run",
    "test:ci": "npm run test -- --coverage",
    "cs": "node --run lint && node --run format:check",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint app scripts test server.ts ./*.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt app scripts test server.ts ./*.config.ts",
    "format:check": "node --run format -- --check",
    "types": "react-router typegen && tsc",
    "start": "NODE_OPTIONS=\"--conditions=development\" tsx ./server.ts",
    "preview": "NODE_ENV=production tsx ./server.ts",
    "migration:create": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:create --config ./migrations.config.ts",
    "migration:run": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:up --config ./migrations.config.ts",
    "migration:down": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:down --config ./migrations.config.ts",
    "password:hash": "tsx ./scripts/hash-password.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@mikro-orm/cli": "^7.1.7",
    "@mikro-orm/core": "^7.1.7",
    "@mikro-orm/mariadb": "^7.1.7",
    "@mikro-orm/migrations": "^7.1.7",
    "@mikro-orm/mssql": "^7.1.7",
    "@mikro-orm/mysql": "^7.0.4",
    "@mikro-orm/postgresql": "^7.1.7",
    "@mikro-orm/sqlite": "^7.1.7",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@shlinkio/shlink-frontend-kit": "^1.5.0",
    "@shlinkio/shlink-js-sdk": "^3.2.1",
    "@shlinkio/shlink-web-component": "^0.19.2",
    "argon2": "^0.45.1",
    "bottlejs": "^2.0.1",
    "express": "^5.2.1",
    "isbot": "^5.2.1",
    "libsql": "^0.5.29",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-external-link": "^2.7.0",
    "react-router": "^8.3.0",
    "remix-auth": "^4.2.0",
    "remix-auth-form": "^3.0.0",
    "tsx": "^4.23.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@shlinkio/eslint-config-js-coding-standard": "~4.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "adm-zip": "^0.6.0",
    "axe-core": "4.12.1",
    "chalk": "^6.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.0.1",
    "typescript": "^7.0.2",
    "unplugin-strip-exports": "^0.1.9",
    "vite": "^8.2.0",
    "vitest": "^4.0.17"
  }
}
