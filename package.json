{
  "name": "shlink-dashboard",
  "description": "",
  "main": "build/server.js",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build && tsc --project tsconfig.build-server.json && cp -R app/db/migrations build/migrations && cp migrations.config.ts build/migrations.config.ts && tsx scripts/replace-version.ts",
    "build:dist": "node --run build && tsx ./scripts/create-dist-file.ts",
    "test": "vitest run",
    "test:ci": "npm run test -- --coverage",
    "lint": "eslint app scripts test server.ts *.config.{js,ts}",
    "lint:fix": "npm run lint -- --fix",
    "types": "react-router typegen && tsc",
    "start": "tsx ./server.ts",
    "preview": "NODE_ENV=production tsx ./server.ts",
    "migration:create": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:create --config ./migrations.config.ts",
    "migration:run": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:up --config ./migrations.config.ts",
    "migration:down": "./node_modules/tsx/dist/cli.mjs ./node_modules/@mikro-orm/cli/cli.js migration:down --config ./migrations.config.ts",
    "password:hash": "tsx ./scripts/hash-password.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@mikro-orm/cli": "^7.0.8",
    "@mikro-orm/core": "^7.0.8",
    "@mikro-orm/mariadb": "^7.0.8",
    "@mikro-orm/migrations": "^7.0.8",
    "@mikro-orm/mssql": "^7.0.8",
    "@mikro-orm/mysql": "^7.0.4",
    "@mikro-orm/postgresql": "^7.0.8",
    "@mikro-orm/sqlite": "^7.0.8",
    "@react-router/express": "^7.14.0",
    "@react-router/node": "^7.14.0",
    "@shlinkio/shlink-frontend-kit": "^1.4.0",
    "@shlinkio/shlink-js-sdk": "^3.1.0",
    "@shlinkio/shlink-web-component": "^0.18.0",
    "argon2": "^0.44.0",
    "bottlejs": "^2.0.1",
    "express": "^5.2.1",
    "isbot": "^5.1.37",
    "libsql": "^0.5.29",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-external-link": "^2.6.1",
    "react-router": "^7.4.1",
    "remix-auth": "^4.2.0",
    "remix-auth-form": "^3.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "^7.14.0",
    "@shlinkio/eslint-config-js-coding-standard": "~3.7.0",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "adm-zip": "^0.5.17",
    "axe-core": "4.11.2",
    "chalk": "^5.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "unplugin-strip-exports": "^0.1.9",
    "vite": "^8.0.3",
    "vitest": "^4.0.17"
  }
}
